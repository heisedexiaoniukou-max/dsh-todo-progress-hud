{
  "name": "dsh-todo-progress-hud",
  "version": "1.7.1",
  "type": "module",
  "description": "Floating task-progress HUD for DeepSeek Harness: a top progress bar with milestone lights that follows the session todo list.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "todo",
    "progress",
    "hud",
    "ui"
  ],
  "license": "MIT",
  "author": "heisedexiaoniukou-max",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heisedexiaoniukou-max/dsh-todo-progress-hud.git"
  },
  "homepage": "https://github.com/heisedexiaoniukou-max/dsh-todo-progress-hud#readme",
  "bugs": {
    "url": "https://github.com/heisedexiaoniukou-max/dsh-todo-progress-hud/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
