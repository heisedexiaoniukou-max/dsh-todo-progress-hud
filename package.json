{
  "name": "dsh-todo-progress-hud",
  "version": "2.1.0",
  "type": "module",
  "description": "任务进度条 for DeepSeek Harness：把会话的 todo 清单变成输入框上方一条常驻进度条，实时显示完成度、当前步骤与每一项状态。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "todo",
    "todo-list",
    "progress",
    "progress-bar",
    "task",
    "task-tracking",
    "hud",
    "ui"
  ],
  "license": "MIT",
  "author": "heisedexiaoniukou-max",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heisedexiaoniukou-max/dsh-todo-progress-hud.git"
  },
  "homepage": "https://github.com/heisedexiaoniukou-max/dsh-todo-progress-hud#readme",
  "bugs": {
    "url": "https://github.com/heisedexiaoniukou-max/dsh-todo-progress-hud/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
